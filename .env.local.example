# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. In production, set the same vars in
# Vercel → Settings → Environment Variables (Production / Preview / Development).

# ── Supabase ────────────────────────────────────────────────────────────────
# Public anon key is safe to ship to the browser; service role key is NOT and
# must only be set on edge functions / server contexts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Stripe ──────────────────────────────────────────────────────────────────
# Server: secret key is used by /app/api/create-payment-intent/route.ts.
# Without it the route returns 503 "Payment provider not configured".
STRIPE_SECRET_KEY=sk_test_xxx

# Client: publishable key is read by /app/(main)/booking/checkout/page.tsx
# via loadStripe(). Must start with NEXT_PUBLIC_ to be exposed to the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ── Stripe webhook (set on the Supabase Edge Function, not here) ────────────
# Webhook URL to register in Stripe Dashboard → Developers → Webhooks:
#   https://<your-project-ref>.supabase.co/functions/v1/stripe-webhook
# Subscribe to events:
#   checkout.session.completed
#   payment_intent.succeeded
#   payment_intent.payment_failed
# Then copy the signing secret (whsec_…) into the Supabase function's
# STRIPE_WEBHOOK_SECRET env var (Supabase → Edge Functions → stripe-webhook → Secrets).
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Optional ────────────────────────────────────────────────────────────────
# Enables the in-app demo user (no real auth required). Leave unset in prod.
# NEXT_PUBLIC_DEMO_MODE=false
